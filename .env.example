# Copy to .env in the repo root (never commit .env):
#   cp .env.example .env

# ── AI worker (AI_GENERATE jobs) ─────────────────────────────────────────────
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
# Any chat model your key can use
OPENAI_MODEL=gpt-4o-mini
# Optional: USD per 1M tokens for OPENAI_MODEL, from https://openai.com/api/pricing.
# Leave empty to record token counts without a cost.
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=
# Document Q&A: embeddings model and its USD price per 1M tokens (optional)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_PRICE_EMBEDDING_PER_1M=

# ── Node worker (EMAIL_SEND jobs) ────────────────────────────────────────────
# Use a Gmail App Password (https://myaccount.google.com/apppasswords), not your login password.
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
